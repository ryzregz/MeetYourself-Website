# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (Postgres, via Prisma) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Admin auth ────────────────────────────────────────────────────────────────
# Signs the admin portal's session cookie. Generate a strong random value, e.g.:
#   openssl rand -base64 32
JWT_SECRET=

# Used once by `npx prisma db seed` to create the first admin login. Change the
# password inside the portal after first login — there's no self-service
# password reset yet.
ADMIN_SEED_EMAIL=admin@meetyourselfacademy.com
ADMIN_SEED_PASSWORD=change-me-after-first-login

# ── File storage (Vercel Blob) ───────────────────────────────────────────────
# Used by the admin portal to upload book/recording cover images.
# Create a store: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=
